{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seagrass Diagnostic Topics",
  "type": "object",
  "required": ["schemaVersion", "topics"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./topics.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^seagrass/[a-z0-9][a-z0-9.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
