{
  "name": "seagrass-vscode",
  "displayName": "Seagrass",
  "description": "Anchor-specific diagnostics, completions, hovers, symbols, and fixes plus local artifact evidence for Anchor, Pinocchio, and native Solana Rust programs.",
  "version": "1.0.2",
  "license": "MIT",
  "publisher": "seagrass-local",
  "private": false,
  "packageManager": "bun@1.3.8",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "onCommand:seagrass.status",
    "onCommand:seagrass.analyze",
    "onCommand:seagrass.artifacts",
    "onCommand:seagrass.feedback",
    "onCommand:seagrass.errorCoverage",
    "onCommand:seagrass.supportMatrix",
    "onCommand:seagrass.generatorProfile",
    "onCommand:seagrass.logs",
    "onCommand:seagrass.restart",
    "onCommand:seagrass.showOutput",
    "onCommand:seagrass.explainDiagnostic",
    "onCommand:seagrass.suppressDiagnostic",
    "onCommand:seagrass.scanWorkspace",
    "onCommand:seagrass.showTridentCoverage",
    "onCommand:seagrass.closeTridentCoverage",
    "workspaceContains:Anchor.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "seagrass.status",
        "title": "Seagrass: Status"
      },
      {
        "command": "seagrass.analyze",
        "title": "Seagrass: Analyze Document"
      },
      {
        "command": "seagrass.artifacts",
        "title": "Seagrass: Artifacts"
      },
      {
        "command": "seagrass.feedback",
        "title": "Seagrass: Send Feedback"
      },
      {
        "command": "seagrass.errorCoverage",
        "title": "Seagrass: Error Coverage"
      },
      {
        "command": "seagrass.supportMatrix",
        "title": "Seagrass: Support Matrix"
      },
      {
        "command": "seagrass.generatorProfile",
        "title": "Seagrass: Generator Profile"
      },
      {
        "command": "seagrass.logs",
        "title": "Seagrass: Recent Logs"
      },
      {
        "command": "seagrass.restart",
        "title": "Seagrass: Restart Server"
      },
      {
        "command": "seagrass.showOutput",
        "title": "Seagrass: Output"
      },
      {
        "command": "seagrass.explainDiagnostic",
        "title": "Seagrass: Explain Diagnostic"
      },
      {
        "command": "seagrass.suppressDiagnostic",
        "title": "Seagrass: Suppress Diagnostic"
      },
      {
        "command": "seagrass.scanWorkspace",
        "title": "Seagrass: Scan Workspace For Issues"
      },
      {
        "command": "seagrass.showTridentCoverage",
        "title": "Seagrass: Show Trident Coverage"
      },
      {
        "command": "seagrass.closeTridentCoverage",
        "title": "Seagrass: Close Trident Coverage"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "seagrass.status",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.analyze",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.artifacts",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.feedback"
        },
        {
          "command": "seagrass.errorCoverage",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.supportMatrix",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.generatorProfile",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.logs",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.restart",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.showOutput"
        },
        {
          "command": "seagrass.explainDiagnostic",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.suppressDiagnostic",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.scanWorkspace",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "seagrass.showTridentCoverage",
          "when": "editorLangId == rust"
        },
        {
          "command": "seagrass.closeTridentCoverage",
          "when": "editorLangId == rust"
        }
      ],
      "editor/context": [
        {
          "command": "seagrass.explainDiagnostic",
          "when": "editorLangId == rust",
          "group": "seagrass@1"
        },
        {
          "command": "seagrass.suppressDiagnostic",
          "when": "editorLangId == rust",
          "group": "seagrass@2"
        }
      ]
    },
    "configuration": {
      "title": "Seagrass",
      "properties": {
        "seagrass.serverCommand": {
          "type": "string",
          "default": "seagrass",
          "description": "Command used to start Seagrass. Enable seagrass.dev.useCargoFromCheckout for repository development."
        },
        "seagrass.serverArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the Seagrass server command."
        },
        "seagrass.dev.useCargoFromCheckout": {
          "type": "boolean",
          "default": false,
          "description": "When true, launch `cargo run -p seagrass-cli --quiet` from seagrass.serverCwd instead of the installed `seagrass` binary."
        },
        "seagrass.serverCwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the server command. For local development, this must be the checkout that contains the seagrass-cli Cargo package."
        },
        "seagrass.serverEnv": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra environment variables passed to the seagrass server process."
        },
        "seagrass.agent.mode": {
          "type": "boolean",
          "default": false,
          "description": "Fill unset Seagrass analysis settings with assistant and automation diagnostics, security, and tracing defaults. Explicit settings still win."
        },
        "seagrass.feedback.url": {
          "type": "string",
          "default": "",
          "description": "Override the Seagrass feedback URL returned by the language server. Leave empty to use the bundled URL."
        },
        "seagrass.diagnostics.security.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Anchor security diagnostics."
        },
        "seagrass.diagnostics.security.ownerChecks": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for owner-check security diagnostics."
        },
        "seagrass.diagnostics.security.typeCosplay": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for type-cosplay security diagnostics."
        },
        "seagrass.diagnostics.security.accountClosing": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for account-closing security diagnostics."
        },
        "seagrass.diagnostics.security.initialization": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for account-initialization security diagnostics."
        },
        "seagrass.diagnostics.security.staleCpiReload": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for stale-CPI-reload security diagnostics."
        },
        "seagrass.diagnostics.security.signerAuthorization": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for signer-authorization security diagnostics."
        },
        "seagrass.diagnostics.security.arbitraryCpi": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for arbitrary-CPI security diagnostics."
        },
        "seagrass.diagnostics.security.instructionDataBounds": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for instruction-data-bounds security diagnostics."
        },
        "seagrass.diagnostics.security.pdaSeedCollision": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "error",
            "hint"
          ],
          "default": "warn",
          "description": "Severity for PDA seed-collision security diagnostics."
        },
        "seagrass.diagnostics.transport": {
          "type": "string",
          "enum": [
            "push",
            "pull",
            "both"
          ],
          "default": "push",
          "description": "Diagnostics transport used for VS Code. Use push by default to avoid duplicate diagnostics; pull enables LSP 3.17 pull diagnostics; both is useful only for protocol debugging and can duplicate diagnostics in VS Code."
        },
        "seagrass.diagnostics.confidenceDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Underline derived and heuristic Seagrass diagnostics differently and show confidence counts in the status bar tooltip. Confidence metadata is attached by the server as related information."
        },
        "seagrass.tridentCoverage.reportPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Trident llvm-cov JSON report. Leave empty to discover reports under trident-tests/ automatically."
        },
        "seagrass.tridentCoverage.searchGlobs": {
          "type": "array",
          "default": [
            "**/trident-tests/**/coverage.json",
            "**/trident-tests/**/coverage/**/*.json",
            "**/*-coverage-report/**/*.json",
            "**/llvm-cov/**/*.json"
          ],
          "items": {
            "type": "string"
          },
          "description": "Workspace globs used to discover Trident coverage JSON when reportPath is empty."
        },
        "seagrass.tridentCoverage.showExecutionCount": {
          "type": "boolean",
          "default": true,
          "description": "Show per-line execution counts from Trident coverage in the editor gutter."
        },
        "seagrass.diagnostics.coldPath": {
          "type": "string",
          "enum": [
            "idle",
            "save",
            "manual"
          ],
          "default": "idle",
          "description": "When Seagrass runs full cold-path diagnostics. idle runs after a typing pause, save runs on open/save but not every change, manual leaves full checks to pull diagnostics and explicit commands."
        },
        "seagrass.diagnostics.experimental.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable experimental Anchor diagnostics."
        },
        "seagrass.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Anchor inlay hints."
        },
        "seagrass.workspaceIndex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable project-aware Anchor workspace indexing."
        },
        "seagrass.trace.server": {
          "type": "boolean",
          "default": false,
          "description": "Enable extra Seagrass server tracing."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --target=node --format=cjs --external=vscode --outdir ./dist",
    "check": "bun run typecheck && bun run build && node --check ./dist/extension.js && bun ../check-ui-contract.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.0"
  }
}
